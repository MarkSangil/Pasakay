// PASAKAY database schema - public schema + auth.users identity reference
// Source of truth: live Supabase Postgres (read-only pg_catalog / information_schema
// introspection, 2026-10-17), cross-checked against apps/admin/supabase/migrations/*.sql.
// Usage: paste the entire file into a new project at https://dbdiagram.io

Project pasakay {
  database_type: "PostgreSQL"
  Note: "PASAKAY Android tricycle-scheduling prototype. auth.users (Supabase-managed) shows only id, the identity parent of the profile tables."
}

enum account_status {
  "pending_verification"
  "active"
  "suspended"
  "deactivated"
}

enum privacy_request_status {
  "received"
  "in_progress"
  "completed"
  "denied"
  "retained"
}

enum privacy_request_type {
  "access"
  "correction"
  "deletion"
}

enum user_role {
  "commuter"
  "driver"
}

// Supabase Auth managed table. Only `id` is shown.
table auth.users {
  id uuid [pk]
  Note: "Verified via public->auth FKs from admins/commuters/drivers."
}

table admins {
  admin_id uuid [pk]
  full_name text [not null]
  email text [not null, unique]
  username text [not null, unique]
  is_active boolean [not null, default: true]
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]
}

table app_notification_settings {
  key text [pk]
  value text [not null]
  updated_at "timestamp with time zone" [not null, default: `now()`]
}

table booking_events {
  event_id uuid [pk, default: `gen_random_uuid()`]
  event_type text [not null]
  request_id uuid
  booking_id uuid
  actor_id uuid
  details jsonb [not null, default: '{}']
  created_at "timestamp with time zone" [not null, default: `now()`]
  indexes {
    (created_at) [name: 'booking_events_created_idx']
  }
}

table bookings {
  booking_id uuid [pk, default: `gen_random_uuid()`]
  request_id uuid [not null, unique]
  commuter_id uuid [not null]
  driver_id uuid [not null]
  status text [not null]
  confirmed_at "timestamp with time zone" [not null, default: `now()`]
  completed_at "timestamp with time zone"
  cancelled_at "timestamp with time zone"
  flagged_at "timestamp with time zone"
  flagged_by uuid
  flag_reason text
  flag_details text
  review_eligible_at "timestamp with time zone" [not null]
  reviewed_at "timestamp with time zone"
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]
  passenger_name text
  passenger_reported_at "timestamp with time zone"
  indexes {
    (status, confirmed_at) [name: 'bookings_auto_complete_idx']
    (commuter_id, status, confirmed_at) [name: 'bookings_commuter_status_idx']
    (driver_id, status, confirmed_at) [name: 'bookings_driver_status_idx']
    (passenger_reported_at) [name: 'bookings_passenger_reported_idx']
    (status, review_eligible_at) [name: 'bookings_review_due_idx']
    // bookings_auto_complete_idx: partial index predicate (not expressible in DBML): WHERE (status = 'BOOKED'::text)
    // bookings_passenger_reported_idx: partial index predicate (not expressible in DBML): WHERE (passenger_reported_at IS NOT NULL)
    // bookings_review_due_idx: partial index predicate (not expressible in DBML): WHERE ((status = 'COMPLETED'::text) AND (reviewed_at IS NULL))
  }
}

table commuter_activity_heartbeats {
  heartbeat_id uuid [pk]
  session_id uuid [not null]
  commuter_id uuid [not null]
  beat_at "timestamp with time zone" [not null, default: `now()`]
  indexes {
    (commuter_id, beat_at) [name: 'commuter_activity_heartbeats_commuter_idx']
    (session_id, beat_at) [name: 'commuter_activity_heartbeats_session_idx']
  }
}

table commuter_activity_sessions {
  session_id uuid [pk]
  commuter_id uuid [not null]
  started_at "timestamp with time zone" [not null, default: `now()`]
  last_heartbeat_at "timestamp with time zone" [not null, default: `now()`]
  ended_at "timestamp with time zone"
  end_reason text
  indexes {
    (commuter_id, started_at) [name: 'commuter_activity_sessions_commuter_idx']
  }
}

table commuter_device_tokens {
  id uuid [pk, default: `gen_random_uuid()`]
  commuter_id uuid [not null]
  token text [not null]
  platform text [not null]
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]
  indexes {
    (commuter_id) [name: 'commuter_device_tokens_commuter_id_idx']
    (token) [unique, name: 'commuter_device_tokens_token_uidx']
  }
}

table commuter_followed_drivers {
  commuter_id uuid [not null]
  driver_id uuid [not null]
  created_at "timestamp with time zone" [not null, default: `now()`]
  indexes {
    (driver_id) [name: 'commuter_followed_drivers_driver_idx']
  }
}

table commuter_notification_preferences {
  commuter_id uuid [pk]
  followed_driver_availability boolean [not null, default: true]
  updated_at "timestamp with time zone" [not null, default: `now()`]
}

table commuters {
  commuter_id uuid [pk]
  full_name text [not null]
  contact_number text [not null]
  email_address text
  username text [not null, unique]
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]
  status account_status [not null, default: 'active']
  status_reason text
  indexes {
    (status) [name: 'commuters_status_idx']
  }
}

table device_logs {
  log_id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  user_type user_role [not null]
  device_model text
  os_version text
  app_version text
  access_datetime "timestamp with time zone" [not null, default: `now()`]
  crash_error_log text
  indexes {
    (access_datetime) [name: 'device_logs_access_idx']
    (user_type, user_id, access_datetime) [name: 'device_logs_user_idx']
  }
}

table device_tokens {
  id uuid [pk, default: `gen_random_uuid()`]
  driver_id uuid [not null]
  token text [not null]
  platform text [not null]
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]
  indexes {
    (driver_id) [name: 'device_tokens_driver_id_idx']
    (token) [unique, name: 'device_tokens_token_uidx']
  }
}

table driver_activity_heartbeats {
  heartbeat_id uuid [pk]
  session_id uuid [not null]
  driver_id uuid [not null]
  beat_at "timestamp with time zone" [not null, default: `now()`]
  indexes {
    (driver_id, beat_at) [name: 'driver_activity_heartbeats_driver_idx']
    (session_id, beat_at) [name: 'driver_activity_heartbeats_session_idx']
  }
}

table driver_activity_sessions {
  session_id uuid [pk]
  driver_id uuid [not null]
  started_at "timestamp with time zone" [not null, default: `now()`]
  last_heartbeat_at "timestamp with time zone" [not null, default: `now()`]
  ended_at "timestamp with time zone"
  end_reason text
  indexes {
    (driver_id, started_at) [name: 'driver_activity_sessions_driver_idx']
  }
}

table driver_notification_preferences {
  driver_id uuid [pk]
  schedule_reminders boolean [not null, default: true]
  schedule_changes boolean [not null, default: true]
  availability_changes boolean [not null, default: true]
  updated_at "timestamp with time zone" [not null, default: `now()`]
}

table driver_shift_requests {
  id uuid [pk, default: `gen_random_uuid()`]
  driver_id uuid [not null]
  current_shift_id uuid
  requested_shift_id uuid [not null]
  status text [not null, default: 'pending']
  admin_id uuid
  admin_note text
  created_at "timestamp with time zone" [not null, default: `now()`]
  reviewed_at "timestamp with time zone"
  indexes {
    (status, created_at) [name: 'driver_shift_requests_status_idx']
  }
}

table drivers {
  driver_id uuid [pk]
  full_name text [not null]
  contact_number text [not null]
  driver_license_number text
  plate_number text [not null]
  toda_number text
  username text [not null, unique]
  terminal_id uuid [not null]
  shift_id uuid [not null]
  is_active boolean [not null, default: false]
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]
  current_terminal_id uuid
  license_verified boolean [not null, default: false]
  license_verified_at "timestamp with time zone"
  license_verified_by uuid
  status account_status [not null, default: 'pending_verification']
  status_reason text
  average_rating numeric(3,2) [not null, default: 0]
  review_count integer [not null, default: 0]
  indexes {
    (shift_id) [name: 'drivers_shift_idx']
    (status) [name: 'drivers_status_idx']
    (terminal_id) [name: 'drivers_terminal_idx']
  }
}

table notification_event_log {
  dedupe_key text [pk]
  event_type text [not null]
  recipient_id uuid [not null]
  related_driver_id uuid
  related_shift_id uuid
  created_at "timestamp with time zone" [not null, default: `now()`]
}

table notifications {
  notification_id uuid [pk, default: `gen_random_uuid()`]
  recipient_id uuid [not null]
  recipient_type user_role [not null]
  message_content text [not null]
  date_sent "timestamp with time zone" [not null, default: `now()`]
  is_read boolean [not null, default: false]
  event_type text
  title text
  related_driver_id uuid
  related_shift_id uuid
  dedupe_key text
  data jsonb [not null, default: '{}']
  indexes {
    (dedupe_key) [unique, name: 'notifications_dedupe_key_uidx']
    (recipient_id, date_sent) [name: 'notifications_recipient_date_idx']
    (recipient_type, recipient_id, date_sent) [name: 'notifications_recipient_idx']
    // notifications_dedupe_key_uidx: partial index predicate (not expressible in DBML): WHERE (dedupe_key IS NOT NULL)
  }
}

table privacy_requests {
  request_id uuid [pk, default: `gen_random_uuid()`]
  subject_user_id uuid
  subject_role user_role
  subject_name text [not null]
  subject_contact text
  request_type privacy_request_type [not null]
  status privacy_request_status [not null, default: 'received']
  details text
  correction_payload jsonb
  admin_notes text
  retention_applies boolean [not null, default: false]
  retention_reason text
  handled_by uuid
  received_at "timestamp with time zone" [not null, default: `now()`]
  resolved_at "timestamp with time zone"
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]
  indexes {
    (status, received_at) [name: 'privacy_requests_status_idx']
  }
}

table review_reports {
  report_id uuid [pk, default: `gen_random_uuid()`]
  review_id uuid [not null]
  driver_id uuid [not null]
  reason text [not null]
  details text
  status text [not null, default: 'OPEN']
  created_at "timestamp with time zone" [not null, default: `now()`]
  resolved_at "timestamp with time zone"
  resolved_by uuid
  indexes {
    (review_id, driver_id) [unique, name: 'review_reports_one_open_per_pair']
    // review_reports_one_open_per_pair: partial index predicate (not expressible in DBML): WHERE (status = 'OPEN'::text)
  }
}

table reviews {
  review_id uuid [pk, default: `gen_random_uuid()`]
  commuter_id uuid [not null]
  driver_id uuid [not null]
  rating smallint [not null]
  content text
  date_created "timestamp with time zone" [not null, default: `now()`]
  is_hidden boolean [not null, default: false]
  hidden_at "timestamp with time zone"
  hidden_by uuid
  moderation_note text
  booking_id uuid
  indexes {
    (commuter_id) [name: 'reviews_commuter_idx']
    (driver_id, date_created) [name: 'reviews_driver_idx']
    (is_hidden, date_created) [name: 'reviews_hidden_idx']
    (booking_id) [unique, name: 'reviews_one_per_booking']
    // reviews_one_per_booking: partial index predicate (not expressible in DBML): WHERE (booking_id IS NOT NULL)
  }
}

table ride_requests {
  request_id uuid [pk, default: `gen_random_uuid()`]
  commuter_id uuid [not null]
  driver_id uuid [not null]
  status text [not null]
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]
  expires_at "timestamp with time zone" [not null]
  responded_at "timestamp with time zone"
  passenger_name text
  indexes {
    (commuter_id, status, created_at) [name: 'ride_requests_commuter_status_idx']
    (driver_id, status, created_at) [name: 'ride_requests_driver_status_idx']
    (commuter_id, driver_id) [unique, name: 'ride_requests_one_pending_per_pair']
    // ride_requests_one_pending_per_pair: partial index predicate (not expressible in DBML): WHERE (status = 'PENDING'::text)
  }
}

table shifts {
  shift_id uuid [pk, default: `gen_random_uuid()`]
  shift_start_time time [not null]
  shift_end_time time [not null]
  label text [not null]
  created_at "timestamp with time zone" [not null, default: `now()`]
  indexes {
    (shift_start_time,shift_end_time) [name: 'shifts_shift_start_time_shift_end_time_key']
  }
}

table terminals {
  terminal_id uuid [pk, default: `gen_random_uuid()`]
  terminal_name text [not null, unique]
  created_at "timestamp with time zone" [not null, default: `now()`]
}

table user_audit_logs {
  log_id uuid [pk]
  user_id uuid [not null]
  user_role text [not null]
  action text [not null]
  detail jsonb
  occurred_at "timestamp with time zone" [not null, default: `now()`]
  indexes {
    (action, occurred_at) [name: 'user_audit_logs_action_idx']
    (user_id, occurred_at) [name: 'user_audit_logs_user_idx']
  }
}

// Foreign keys (verified: pg_constraint).
Ref: booking_events.booking_id > bookings.booking_id [delete: set null]
Ref: booking_events.request_id > ride_requests.request_id [delete: set null]
Ref: bookings.commuter_id > commuters.commuter_id
Ref: bookings.driver_id > drivers.driver_id
Ref: bookings.request_id > ride_requests.request_id
Ref: commuter_activity_heartbeats.commuter_id > commuters.commuter_id [delete: cascade]
Ref: commuter_activity_heartbeats.session_id > commuter_activity_sessions.session_id [delete: cascade]
Ref: commuter_activity_sessions.commuter_id > commuters.commuter_id [delete: cascade]
Ref: commuter_device_tokens.commuter_id > commuters.commuter_id [delete: cascade]
Ref: commuter_followed_drivers.commuter_id > commuters.commuter_id [delete: cascade]
Ref: commuter_followed_drivers.driver_id > drivers.driver_id [delete: cascade]
Ref: commuter_notification_preferences.commuter_id > commuters.commuter_id [delete: cascade]
Ref: device_tokens.driver_id > drivers.driver_id [delete: cascade]
Ref: driver_activity_heartbeats.driver_id > drivers.driver_id [delete: cascade]
Ref: driver_activity_heartbeats.session_id > driver_activity_sessions.session_id [delete: cascade]
Ref: driver_activity_sessions.driver_id > drivers.driver_id [delete: cascade]
Ref: driver_notification_preferences.driver_id > drivers.driver_id [delete: cascade]
Ref: driver_shift_requests.admin_id > admins.admin_id [delete: set null]
Ref: driver_shift_requests.current_shift_id > shifts.shift_id [delete: set null]
Ref: driver_shift_requests.driver_id > drivers.driver_id [delete: cascade]
Ref: driver_shift_requests.requested_shift_id > shifts.shift_id [delete: cascade]
Ref: drivers.current_terminal_id > terminals.terminal_id
Ref: drivers.shift_id > shifts.shift_id
Ref: drivers.terminal_id > terminals.terminal_id
Ref: privacy_requests.handled_by > admins.admin_id
Ref: review_reports.driver_id > drivers.driver_id
Ref: review_reports.resolved_by > admins.admin_id
Ref: review_reports.review_id > reviews.review_id [delete: cascade]
Ref: reviews.booking_id > bookings.booking_id
Ref: reviews.commuter_id > commuters.commuter_id [delete: cascade]
Ref: reviews.driver_id > drivers.driver_id [delete: cascade]
Ref: ride_requests.commuter_id > commuters.commuter_id
Ref: ride_requests.driver_id > drivers.driver_id

// Identity bindings to the Supabase Auth table (verified via pg_constraint):
Ref: admins.admin_id > auth.users.id
Ref: commuters.commuter_id > auth.users.id
Ref: drivers.driver_id > auth.users.id

